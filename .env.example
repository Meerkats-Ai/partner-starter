# ── Meerkats Partner Starter ──────────────────────────────────────────────────
# `npm install` auto-creates .env.local with a generated SESSION_SECRET, so the
# ONLY value you have to set is your API key below. This .env.example is just a
# reference — you normally don't copy it by hand.

# Your API key from the Meerkats dashboard (API Keys → Create key). SERVER-ONLY —
# never sent to the browser; the Next.js route handlers add it. Use a write-scoped
# key if you want the automations screen to approve/toggle.
MEERKATS_API_KEY=mk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auto-generated by `npm install` (iron-session cookie secret, 32+ chars). You do
# not need to set this yourself.
# SESSION_SECRET=generated-on-install

# Optional — the app hardcodes the production Partner API base and only reads this
# if set. Uncomment to point at a local/staging API while developing.
# MEERKATS_API_BASE=http://localhost:5000/api/public/v1
