# ── Meerkats Partner API ──────────────────────────────────────────────────────
# Your API key from the Meerkats dashboard (API Keys → Create key). SERVER-ONLY —
# it is never sent to the browser; the Next.js route handlers add it. Use a
# write-scoped key if you want the automations screen to approve/toggle.
MEERKATS_API_KEY=mk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Partner API base URL (leave as-is for production).
MEERKATS_API_BASE=https://partners.meerkats.ai/api/public/v1

# Secret used to encrypt the session cookie (iron-session). MUST be 32+ chars.
# Generate one: `openssl rand -base64 32`
SESSION_SECRET=replace-with-a-long-random-32char-plus-secret
